# ============================================
# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 排除）
# ============================================

# ---------- GitHub ----------
# 【可选】不配也能正常跑。README 默认走 raw.githubusercontent.com，不吃 API 配额。
# 只有当 raw 域名在你网络下不可达时，才需要配这个作兜底。
# 申请：https://github.com/settings/tokens → Generate new token (classic) → 勾 public_repo
# 作用：把 api.github.com 这条次选路线的配额从 60/小时 提到 5000/小时
GITHUB_TOKEN=

# 可选：企业版/代理地址，一般留空
GITHUB_API_BASE=https://api.github.com

# ---------- 大模型 ----------
# provider 可选：deepseek | openai | ollama | mock
LLM_PROVIDER=deepseek

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 本地模型用这个（LLM_PROVIDER=ollama 时生效）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ---------- 行为 ----------
# 每天几点刷新（0-23，本机时区）
REFRESH_HOUR=9
# 每天每个周期抓多少个仓库
MAX_REPOS_PER_PERIOD=25
# 喂给模型的 README 上限字符数
README_MAX_CHARS=12000

# 抓 github.com/trending 的单次请求超时（秒）
# 实测本机抓那 640KB 的页面要 83 秒，设 30 会误判 read timeout。
# 注意：只影响抓 trending，README 候选扫描另有短超时（代码里的 README_SCAN_TIMEOUT=15）。
HTTP_TIMEOUT=90

# 调大模型的单次请求超时（秒）。独立于 HTTP_TIMEOUT —— 模型只回几百字，
# 不需要跟着 trending 一起等 90 秒（旧代码是 HTTP_TIMEOUT*3，最坏 112 分钟）。
LLM_TIMEOUT=90
